  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "node  --expose-gc --max-old-space-size=8192 ./node_modules/.bin/eslint \"{src,apps,libs,test}/**/*.ts\" ",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "node --expose-gc --max-old-space-size=8192 ./node_modules/.bin/jest --runInBand --logHeapUsage --bail --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "node  --max-old-space-size=8192 ./node_modules/.bin/jest --config ./test/jest-e2e.json --bail --detectOpenHandles --logHeapUsage",
    "test:e2e:watch": "jest --config ./test/jest-e2e.json --watch"
  },
